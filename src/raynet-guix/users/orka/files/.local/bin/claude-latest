#!/bin/sh
# Native (self-updating) Claude Code install, kept alongside the Guix `claude`
# (claude-code-bin from the shikanox channel), which is the managed default on PATH.
#
# The upstream binary hardcodes a /lib64 loader that does not exist on Guix, so it
# is invoked through the Guix Home glibc ld.so. argv[0] is left as the real binary
# path so the native updater can locate its version directory.
#
#   claude-latest update      # pull a newer native build
#   claude-latest --version

dir="$HOME/.local/share/claude/versions"
latest="$(ls -1 "$dir" 2>/dev/null | sort -V | tail -n1)"

if [ -z "$latest" ]; then
    echo "claude-latest: no native install found in $dir" >&2
    echo "install one with:  curl -fsSL https://claude.ai/install.sh | bash" >&2
    exit 1
fi

# Stop the native binary from "self-healing" ~/.local/bin/claude (which would
# shadow the Guix claude on PATH). Use `claude-latest update` to bump explicitly.
export DISABLE_AUTOUPDATER=1
export DISABLE_INSTALLATION_CHECKS=1

exec "$HOME/.guix-home/profile/lib/ld-linux-x86-64.so.2" "$dir/$latest" "$@"
