(if [[ "$stage" == 72-multimodel-findings-adjudication ]]; then
  MM_DIR="$STATE_DIR/working/v1.65/multi-model"
  CLAUDE_REPORT="$MM_DIR/final-packet-claude-review.md"
  AGY_REPORT="$MM_DIR/final-packet-agy-review.md"
  CODEX_M4_REPORT="$MM_DIR/codex-final-packet-multiproject-review.md"
  CODEX_INTEGRITY_REPORT="$MM_DIR/codex-final-packet-integrity-review.md"
  FROZEN_HASH="$FROZEN_DIR"
  if [[ ! -s "$AGY_REPORT" ]] || [[ "$(wc -c < "$AGY_REPORT")" -lt 1000 ]]; then
    BACKOFF="$MM_DIR/agy-backoff"
    mkdir -p "$BACKOFF" "$AUTO_DIR/attempts"
    fail_file="$BACKOFF/failures"
    after_file="$BACKOFF/retry-after"
    now=$(date +%s)
    retry_after=0
    [[ -s "$after_file" ]] && read -r retry_after < "$after_file" || true
    if [[ "$retry_after" =~ ^[0-9]+$ ]] && (( now < retry_after )); then
      log "stage 72 Agy/Gemini retry cooling down until $(date -d "@$retry_after" -Is)"
      exit 1
    fi
    agy_prompt_file="$MM_DIR/final-packet-agy-review.prompt.md"
    if [[ ! -s "$agy_prompt_file" ]]; then log "stage 72 missing Agy prompt: $agy_prompt_file"; exit 1; fi
    attempt="$AUTO_DIR/attempts/72-agy-$(date +%Y%m%dT%H%M%S%z)"
    mkdir -m 700 "$attempt"
    cat "$agy_prompt_file" > "$attempt/prompt.md"
    chmod 600 "$attempt/prompt.md"
    output="$attempt/report.md"
    agy_log="$attempt/agy.log"
    set +e
    timeout 20m /home/orka/.local/bin/agy-wrapper --sandbox \
      --add-dir "$REPORT_DIR" --add-dir "$FROZEN_HASH" \
      --print-timeout 15m --prompt "$(cat "$attempt/prompt.md")" > "$output" 2> "$agy_log"
    agy_result=$?
    set -e
    agy_bytes=0
    [[ ! -s "$output" ]] || agy_bytes=$(wc -c < "$output")
    if [[ "$agy_result" -eq 0 && "$agy_bytes" -ge 1000 ]] \
      && ! head -n 5 "$output" | grep -Eiq 'API Error:|OVERLOADED_ERROR|RESOURCE_EXHAUSTED|rate limit|too many requests|temporarily unavailable'; then
      mv "$output" "$AGY_REPORT"
      chmod 600 "$AGY_REPORT"
      printf '0\n' > "$fail_file"
      printf '0\n' > "$after_file"
      log "stage 72 saved fresh Agy/Gemini packet review: $AGY_REPORT"
    else
      [[ -s "$output" ]] && chmod 600 "$output"
      failures=0
      [[ -s "$fail_file" ]] && read -r failures < "$fail_file" || true
      [[ "$failures" =~ ^[0-9]+$ ]] || failures=0
      failures=$((failures + 1))
      delay=900
      for ((i=1; i<failures && delay<14400; i++)); do delay=$((delay * 2)); done
      (( delay > 14400 )) && delay=14400
      retry_after=$((now + delay))
      printf '%s\n' "$failures" > "$fail_file.tmp"
      printf '%s\n' "$retry_after" > "$after_file.tmp"
      chmod 600 "$fail_file.tmp" "$after_file.tmp"
      mv "$fail_file.tmp" "$fail_file"
      mv "$after_file.tmp" "$after_file"
      log "stage 72 Agy/Gemini review incomplete (exit $agy_result, ${agy_bytes} bytes); retry after ${delay}s at $(date -d "@$retry_after" -Is)"
      exit 1
    fi
  fi
  if [[ ! -s "$CLAUDE_REPORT" ]] || [[ "$(wc -c < "$CLAUDE_REPORT")" -lt 1000 ]]; then
    log 'stage 72 waiting for complete fresh Claude packet review; Agy report is retained if already complete'
    exit 1
  fi
  if [[ ! -s "$CODEX_M4_REPORT" ]] || [[ "$(wc -c < "$CODEX_M4_REPORT")" -lt 1000 ]] \
    || [[ ! -s "$CODEX_INTEGRITY_REPORT" ]] || [[ "$(wc -c < "$CODEX_INTEGRITY_REPORT")" -lt 1000 ]]; then
    log 'stage 72 waiting for both independent Codex peer reports'
    exit 1
  fi
fi)
if [[ "$stage" == 77-final-multimodel-adjudication ]]; then
  MM_DIR="$STATE_DIR/working/v1.65/multi-model"
  mkdir -p "$MM_DIR"
  CLAUDE_REPORT="$MM_DIR/final-packet-claude-r2-review.md"
  AGY_REPORT="$MM_DIR/final-packet-agy-r2-review.md"
  CLAUDE_PROMPT="$AUTO_DIR/77-claude-final-review.prompt.md"
  AGY_PROMPT="$AUTO_DIR/77-agy-final-review.prompt.md"
  for f in "$CLAUDE_PROMPT" "$AGY_PROMPT"; do [[ -s "$f" ]] || { log "stage 77 missing external-review prompt: $f"; exit 1; }; done
  if [[ ! -s "$CLAUDE_REPORT" ]] || [[ "$(wc -c < "$CLAUDE_REPORT")" -lt 1000 ]]; then
    attempt="$AUTO_DIR/attempts/77-claude-$(date +%Y%m%dT%H%M%S%z)"
    mkdir -m 700 "$attempt"
    cat "$CLAUDE_PROMPT" > "$attempt/prompt.md"
    printf '\n\nFrozen snapshot root: %s\n' "$FROZEN_DIR" >> "$attempt/prompt.md"
    chmod 600 "$attempt/prompt.md"
    : > "$attempt/report.md"
    set +e
    timeout 30m /home/orka/.guix-profile/lib/ld-linux-x86-64.so.2 \
      /home/orka/.npm-global/lib/node_modules/@anthropic-ai/claude-code/bin/claude.exe \
      --restricted --tools Read Grep Glob --add-dir "$REPORT_DIR" "$FROZEN_DIR" \
      --output-format text -p "$(cat "$attempt/prompt.md")" \
      > "$attempt/report.md" 2> "$attempt/claude.log"
    claude_result=$?
    set -e
    claude_bytes=$(wc -c < "$attempt/report.md")
    if [[ "$claude_result" -eq 0 && "$claude_bytes" -ge 1000 ]] \
      && ! head -n 8 "$attempt/report.md" | grep -Eiq 'API Error:|OVERLOADED_ERROR|RESOURCE_EXHAUSTED|rate limit|temporarily unavailable'; then
      cp "$attempt/report.md" "$CLAUDE_REPORT.tmp"
      chmod 600 "$CLAUDE_REPORT.tmp"; mv "$CLAUDE_REPORT.tmp" "$CLAUDE_REPORT"
      log "stage 77 saved fresh Claude final-packet review: $CLAUDE_REPORT"
    else
      log "stage 77 Claude review incomplete (exit $claude_result, ${claude_bytes} bytes); retry at next hourly tick"
      exit 1
    fi
  fi
  if [[ ! -s "$AGY_REPORT" ]] || [[ "$(wc -c < "$AGY_REPORT")" -lt 1000 ]]; then
    BACKOFF="$MM_DIR/agy-r2-backoff"
    mkdir -p "$BACKOFF" "$AUTO_DIR/attempts"
    fail_file="$BACKOFF/failures"; after_file="$BACKOFF/retry-after"
    now=$(date +%s); retry_after=0
    [[ -s "$after_file" ]] && read -r retry_after < "$after_file" || true
    if [[ "$retry_after" =~ ^[0-9]+$ ]] && (( now < retry_after )); then
      log "stage 77 Agy/Gemini retry cooling down until $(date -d "@$retry_after" -Is)"; exit 1
    fi
    attempt="$AUTO_DIR/attempts/77-agy-$(date +%Y%m%dT%H%M%S%z)"
    mkdir -m 700 "$attempt"
    cat "$AGY_PROMPT" > "$attempt/prompt.md"
    printf '\n\nFrozen snapshot root: %s\n' "$FROZEN_DIR" >> "$attempt/prompt.md"
    chmod 600 "$attempt/prompt.md"; : > "$attempt/report.md"
    set +e
    timeout 20m /home/orka/.local/bin/agy-wrapper --sandbox \
      --add-dir "$REPORT_DIR" --add-dir "$FROZEN_DIR" \
      --print-timeout 15m --prompt "$(cat "$attempt/prompt.md")" \
      > "$attempt/report.md" 2> "$attempt/agy.log"
    agy_result=$?; set -e
    agy_bytes=$(wc -c < "$attempt/report.md")
    if [[ "$agy_result" -eq 0 && "$agy_bytes" -ge 1000 ]] \
      && ! head -n 8 "$attempt/report.md" | grep -Eiq 'API Error:|OVERLOADED_ERROR|RESOURCE_EXHAUSTED|rate limit|too many requests|temporarily unavailable'; then
      cp "$attempt/report.md" "$AGY_REPORT.tmp"
      chmod 600 "$AGY_REPORT.tmp"; mv "$AGY_REPORT.tmp" "$AGY_REPORT"
      printf '0\n' > "$fail_file"; printf '0\n' > "$after_file"
      log "stage 77 saved fresh Agy/Gemini final-packet review: $AGY_REPORT"
    else
      failures=0; [[ -s "$fail_file" ]] && read -r failures < "$fail_file" || true
      [[ "$failures" =~ ^[0-9]+$ ]] || failures=0
      failures=$((failures + 1)); delay=900
      for ((i=1; i<failures && delay<14400; i++)); do delay=$((delay * 2)); done
      (( delay > 14400 )) && delay=14400
      retry_after=$((now + delay))
      printf '%s\n' "$failures" > "$fail_file.tmp"; printf '%s\n' "$retry_after" > "$after_file.tmp"
      chmod 600 "$fail_file.tmp" "$after_file.tmp"; mv "$fail_file.tmp" "$fail_file"; mv "$after_file.tmp" "$after_file"
      log "stage 77 Agy/Gemini review incomplete (exit $agy_result, ${agy_bytes} bytes); retry after ${delay}s"
      exit 1
    fi
  fi
fi
if [[ "$stage" == 134-agy-multimodel-review ]]; then
  MM_DIR="$STATE_DIR/working/v1.65/multi-model/workspace-pattern-review-20261005"
  BACKOFF="$STATE_DIR/provider-backoff"
  AGY_REPORT="$MM_DIR/agy-review-retry.md"
  AGY_PROMPT="$AUTO_DIR/134-agy-external-review.prompt.md"
  mkdir -p "$MM_DIR" "$BACKOFF"
  [[ -s "$AGY_PROMPT" ]] || { log "stage 134 missing Agy external-review prompt: $AGY_PROMPT"; exit 1; }
  if [[ -e "$AGY_REPORT" ]]; then
    if [[ -s "$AGY_REPORT" ]] && [[ "$(wc -c < "$AGY_REPORT")" -ge 1000 ]] \
      && ! head -n 8 "$AGY_REPORT" | grep -Eiq 'API Error:|OVERLOADED_ERROR|RESOURCE_EXHAUSTED|rate limit|too many requests|temporarily unavailable'; then
      log "stage 134 reusing completed Agy/Gemini review: $AGY_REPORT"
    else
      log "stage 134 found an existing incomplete Agy report; refusing overwrite: $AGY_REPORT"
      exit 1
    fi
  else
    # Share both the provider lock and cooldown state with the 15-minute runner.
    exec 8>"$STATE_DIR/lock"
    flock -n 8 || { log 'stage 134 deferred because another provider task holds the shared lock'; exit 1; }
    fail_file="$BACKOFF/agy-failures"; after_file="$BACKOFF/agy-retry-after"
    now=$(date +%s); retry_after=0
    [[ -s "$after_file" ]] && read -r retry_after < "$after_file" || true
    if [[ "$retry_after" =~ ^[0-9]+$ ]] && (( now < retry_after )); then
      log "stage 134 Agy/Gemini retry cooling down until $(date -d "@$retry_after" -Is)"
      exit 1
    fi
    attempt="$AUTO_DIR/attempts/134-agy-$(date +%Y%m%dT%H%M%S%z)"
    context_dir="$attempt/context"
    mkdir -m 700 "$attempt"
    mkdir -m 700 "$context_dir"
    (cd "$FROZEN_DIR" && sha256sum --status -c SHA256SUMS) || { log 'stage 134 frozen source checksum failure before Agy call'; exit 1; }
    cp -a "$FROZEN_DIR" "$context_dir/frozen"
    input_files=(
      "$REPORT_DIR/v1.65-a99-longterm-126-cross-workspace-review-adjudication-20261005.md"
      "$REPORT_DIR/v1.65-a99-longterm-127-stage126-independent-audit-20261005.md"
      "$REPORT_DIR/v1.65-a99-longterm-128-cross-workspace-adjudication-correction-20261005.md"
      "$REPORT_DIR/v1.65-a99-longterm-129-cross-workspace-adjudication-audit-20261005.md"
      "$REPORT_DIR/v1.65-a99-longterm-130-f0-owner-form-correction-20261005.md"
      "$REPORT_DIR/v1.65-a99-longterm-131-f0-owner-form-audit-20261005.md"
      "$REPORT_DIR/v1.65-a99-longterm-132-f0-owner-form-audit-correction-20261005.md"
      "$REPORT_DIR/v1.65-a99-longterm-133-f0-owner-form-correction-audit-20261005.md"
      "$REPORT_DIR/v1.65-a99-cross-project-doc-evidence-review-20261005.md"
      "$REPORT_DIR/v1.65-tcg-workspace-context-stress-review-20261005.md"
      "$MM_DIR/claude-review.md"
      "/home/orka/work/stock-trading/docs/helixdb-schema-manual.md"
    )
    for input_file in "${input_files[@]}"; do
      [[ -s "$input_file" ]] || { log "stage 134 missing review input: $input_file"; exit 1; }
    done
    install -m 400 "${input_files[0]}" "$context_dir/stage126.md"
    install -m 400 "${input_files[1]}" "$context_dir/stage127.md"
    install -m 400 "${input_files[2]}" "$context_dir/stage128.md"
    install -m 400 "${input_files[3]}" "$context_dir/stage129.md"
    install -m 400 "${input_files[4]}" "$context_dir/stage130.md"
    install -m 400 "${input_files[5]}" "$context_dir/stage131.md"
    install -m 400 "${input_files[6]}" "$context_dir/stage132.md"
    install -m 400 "${input_files[7]}" "$context_dir/stage133.md"
    install -m 400 "${input_files[8]}" "$context_dir/ai-workflow-stock-trading-review.md"
    install -m 400 "${input_files[9]}" "$context_dir/tcg-workspace-review.md"
    install -m 400 "${input_files[10]}" "$context_dir/claude-review.md"
    install -m 400 "${input_files[11]}" "$context_dir/stock-trading-manual.md"
    {
      cat <<'EOF_SOURCE_MAP'
# Stage 134 read-only review context

- `frozen/`: copy of the hash-verified six-file v1.65 snapshot; verify with `frozen/SHA256SUMS`.
EOF_SOURCE_MAP
      printf -- '- `stage126.md`: %s\n' "${input_files[0]}"
      printf -- '- `stage127.md`: %s\n' "${input_files[1]}"
      printf -- '- `stage128.md`: %s\n' "${input_files[2]}"
      printf -- '- `stage129.md`: %s\n' "${input_files[3]}"
      printf -- '- `stage130.md`: %s\n' "${input_files[4]}"
      printf -- '- `stage131.md`: %s\n' "${input_files[5]}"
      printf -- '- `stage132.md`: %s\n' "${input_files[6]}"
      printf -- '- `stage133.md`: %s\n' "${input_files[7]}"
      printf -- '- `ai-workflow-stock-trading-review.md`: %s\n' "${input_files[8]}"
      printf -- '- `tcg-workspace-review.md`: %s\n' "${input_files[9]}"
      printf -- '- `claude-review.md`: %s\n' "${input_files[10]}"
      printf -- '- `stock-trading-manual.md`: %s\n' "${input_files[11]}"
    } > "$context_dir/SOURCE-MAP.md"
    chmod -R a-w "$context_dir"
    (cd "$context_dir/frozen" && sha256sum --status -c SHA256SUMS) || { log 'stage 134 frozen copy checksum failure before Agy call'; exit 1; }
    cat "$AGY_PROMPT" > "$attempt/prompt.md"
    printf '\n\nRead-only review context: %s\nFrozen snapshot copy: %s/frozen\nSource mapping: %s/SOURCE-MAP.md\n' "$context_dir" "$context_dir" "$context_dir" >> "$attempt/prompt.md"
    chmod 600 "$attempt/prompt.md"; : > "$attempt/report.md"
    set +e
    (cd "$context_dir" && timeout 20m /home/orka/.local/bin/agy-wrapper --sandbox \
      --print-timeout 15m --prompt "$(cat "$attempt/prompt.md")") \
      > "$attempt/report.md" 2> "$attempt/agy.log"
    agy_result=$?; set -e
    agy_bytes=$(wc -c < "$attempt/report.md")
    (cd "$context_dir/frozen" && sha256sum --status -c SHA256SUMS) || { log 'stage 134 Agy modified the isolated frozen copy; rejecting report'; exit 1; }
    (cd "$FROZEN_DIR" && sha256sum --status -c SHA256SUMS) || { log 'stage 134 frozen source checksum failure after Agy call'; exit 1; }
    if [[ "$agy_result" -eq 0 && "$agy_bytes" -ge 1000 ]] \
      && ! head -n 8 "$attempt/report.md" | grep -Eiq 'API Error:|OVERLOADED_ERROR|RESOURCE_EXHAUSTED|rate limit|too many requests|temporarily unavailable'; then
      cp "$attempt/report.md" "$AGY_REPORT.tmp"
      chmod 600 "$AGY_REPORT.tmp"; mv "$AGY_REPORT.tmp" "$AGY_REPORT"
      printf '0\n' > "$fail_file"; printf '0\n' > "$after_file"
      log "stage 134 saved Agy/Gemini review: $AGY_REPORT"
      flock -u 8; exec 8>&-
    else
      failures=0; [[ -s "$fail_file" ]] && read -r failures < "$fail_file" || true
      [[ "$failures" =~ ^[0-9]+$ ]] || failures=0
      failures=$((failures + 1)); delay=900
      for ((i=1; i<failures && delay<14400; i++)); do delay=$((delay * 2)); done
      (( delay > 14400 )) && delay=14400
      retry_after=$(($(date +%s) + delay))
      printf '%s\n' "$failures" > "$fail_file.tmp"; printf '%s\n' "$retry_after" > "$after_file.tmp"
      chmod 600 "$fail_file.tmp" "$after_file.tmp"; mv "$fail_file.tmp" "$fail_file"; mv "$after_file.tmp" "$after_file"
      log "stage 134 Agy/Gemini review incomplete (exit $agy_result, ${agy_bytes} bytes); retry after ${delay}s at $(date -d "@$retry_after" -Is)"
      exit 1
    fi
  fi
fi
(cd "$FROZEN_DIR" && sha256sum --status -c SHA256SUMS) || { log 'frozen source checksum failure before run'; exit 1; }
name="v1.65-a99-longterm-${stage}-$(date +%Y%m%d).md"
final="$REPORT_DIR/$name"
if [[ -s "$final" ]]; then
  if grep -q -- "- Stage: \`$stage\`" "$final" \
    && (cd "$FROZEN_DIR" && sha256sum --status -c SHA256SUMS); then
    next=$(next_stage_for "$stage")
    printf '%s\n' "$next" > "$AUTO_DIR/stage.tmp"
    mv "$AUTO_DIR/stage.tmp" "$AUTO_DIR/stage"
    printf '# A99 automated review queue status\n\n- Updated: %s\n- Recovered completed report: `%s`\n- Next stage: `%s`\n- Mode: report-only; no schema decisions are adopted.\n' "$(date -Is)" "$final" "$next" > "$AUTO_DIR/status.md.tmp"
    chmod 600 "$AUTO_DIR/status.md.tmp"; mv "$AUTO_DIR/status.md.tmp" "$AUTO_DIR/status.md"
    log "recovered stage $stage from its already completed report; next=$next"
    exit 0
  fi
  log "stage report exists but does not verify against stage/checksum; refusing overwrite: $final"
  exit 1
fi
stamp=$(date +%Y%m%dT%H%M%S%z)
attempt="$AUTO_DIR/attempts/${stage}-${stamp}"
mkdir -m 700 "$attempt"
printf '# Automated A99 report attempt\n\n- Stage: `%s`\n- Started: %s\n- Frozen snapshot: `%s`\n- State: running\n' "$stage" "$(date -Is)" "$FROZEN_DIR" > "$attempt/status.md"
chmod 600 "$attempt/status.md"
prompt_file="$AUTO_DIR/$stage.prompt.md"
[[ -s "$prompt_file" ]] || { log "missing prompt: $prompt_file"; exit 1; }
output="$attempt/report.md"
logfile="$attempt/codex.log"
cat "$prompt_file" > "$attempt/prompt.md"
printf '\n\nFrozen snapshot root: %s\nUse read-only tools to inspect and verify the named input files. Do not write or modify files. Return only the complete standalone report; the runner saves your final response.\n' "$FROZEN_DIR" >> "$attempt/prompt.md"
chmod 600 "$attempt/prompt.md"
set +e
timeout 30m /home/orka/.npm-global/bin/codex exec --sandbox read-only --ephemeral --skip-git-repo-check \
  -C "$REPORT_DIR" -o "$output" < "$attempt/prompt.md" > /dev/null 2> "$logfile"
result=$?
set -e
if [[ "$result" -ne 0 ]] && grep -Eiq 'Selected model is at capacity|OVERLOADED_ERROR|RESOURCE_EXHAUSTED|rate limit|too many requests' "$logfile"; then
  fallback_log="$attempt/codex-fallback.log"
  rm -f "$output"
  log "capacity/rate response for $stage; retrying once with gpt-6-sol"
  set +e
  timeout 30m /home/orka/.npm-global/bin/codex exec --model gpt-6-sol --sandbox read-only --ephemeral --skip-git-repo-check \
    -C "$REPORT_DIR" -o "$output" < "$attempt/prompt.md" > /dev/null 2> "$fallback_log"
  fallback_result=$?
  set -e
  cat "$fallback_log" >> "$logfile"
  result=$fallback_result
  if [[ "$result" -ne 0 ]] && grep -Eiq 'Selected model is at capacity|OVERLOADED_ERROR|RESOURCE_EXHAUSTED|rate limit|too many requests|tokens used' "$fallback_log"; then
    fallback2_log="$attempt/codex-fallback2.log"
    rm -f "$output"
    log "fallback gpt-6-sol unavailable for $stage; retrying once with gpt-6.1-sol"
    set +e
    timeout 30m /home/orka/.npm-global/bin/codex exec --model gpt-6.1-sol --sandbox read-only --ephemeral --skip-git-repo-check \
      -C "$REPORT_DIR" -o "$output" < "$attempt/prompt.md" > /dev/null 2> "$fallback2_log"
    fallback2_result=$?
    set -e
    cat "$fallback2_log" >> "$logfile"
    result=$fallback2_result
    if [[ "$result" -ne 0 ]] && grep -Eiq 'Selected model is at capacity|OVERLOADED_ERROR|RESOURCE_EXHAUSTED|rate limit|too many requests' "$fallback2_log"; then
      fallback3_log="$attempt/codex-fallback3.log"
      rm -f "$output"
      log "fallback gpt-6.1-sol unavailable for $stage; retrying once with gpt-5.6-sol"
      set +e
      timeout 30m /home/orka/.npm-global/bin/codex exec --model gpt-5.6-sol --sandbox read-only --ephemeral --skip-git-repo-check \
        -C "$REPORT_DIR" -o "$output" < "$attempt/prompt.md" > /dev/null 2> "$fallback3_log"
      fallback3_result=$?
      set -e
      cat "$fallback3_log" >> "$logfile"
      result=$fallback3_result
    fi
  fi
fi
if ! (cd "$FROZEN_DIR" && sha256sum --status -c SHA256SUMS); then
  printf 'Frozen input checksum drift detected after review; report is untrusted and stage will retry.\n' >> "$attempt/status.md"
  log "checksum drift after $stage; not advancing"
  exit 1
fi
if [[ "$result" -eq 0 && -s "$output" && $(wc -c < "$output") -ge 1200 ]] && ! head -n 8 "$output" | grep -Eiq 'API Error:|OVERLOADED_ERROR|RESOURCE_EXHAUSTED|rate limit|too many requests|temporarily unavailable'; then
  {
    printf '# Automated A99 report\n\n- Stage: `%s`\n- Completed: %s\n- Frozen snapshot: `%s`\n- State: complete; report-only.\n\n---\n\n' "$stage" "$(date -Is)" "$FROZEN_DIR"
    cat "$output"
  } > "$final.tmp"
  chmod 600 "$final.tmp"
  mv "$final.tmp" "$final"
  printf 'complete\n' > "$attempt/result"
  next=$(next_stage_for "$stage")
  printf '%s\n' "$next" > "$AUTO_DIR/stage.tmp"
  mv "$AUTO_DIR/stage.tmp" "$AUTO_DIR/stage"
  printf '# A99 automated review queue status\n\n- Updated: %s\n- Last completed: `%s`\n- Report: `%s`\n- Next stage: `%s`\n- Mode: report-only; inputs remain frozen and no schema decisions are adopted.\n' "$(date -Is)" "$stage" "$final" "$next" > "$AUTO_DIR/status.md.tmp"
  chmod 600 "$AUTO_DIR/status.md.tmp"; mv "$AUTO_DIR/status.md.tmp" "$AUTO_DIR/status.md"
  log "completed $stage report: $final; next=$next"
else
  printf 'retry\n' > "$attempt/result"
  printf 'Codex exit status: %s\n' "$result" >> "$attempt/status.md"
  chmod 600 "$attempt"/* 2>/dev/null || true
  log "stage $stage incomplete (exit $result); report retained in $attempt and will retry at the next hourly tick"
  exit 1
fi
