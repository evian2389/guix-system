#!/bin/sh
# Interactive Toad (ACP TUI) frontend for the existing MeClaw service.
# Usage: toad-meclaw [--session NAME | --new]   (run inside a Herdr pane)
# Default: one conversation per project directory; --new starts a fresh one.
case "$1" in
  --session) if [ -n "$2" ]; then MECLAW_ACP_SESSION="$2"; export MECLAW_ACP_SESSION; shift 2; fi ;;
  --new) MECLAW_ACP_SESSION="new-$(date +%Y%m%d-%H%M%S)"; export MECLAW_ACP_SESSION; shift ;;
esac
curl -fsS --max-time 5 http://127.0.0.1:10964/health >/dev/null 2>&1 || { echo "Start the MeClaw service first: herd start meclaw" >&2; exit 1; }
exec "$HOME/.local/bin/toad" acp -t MeClaw -d "$PWD" "$HOME/.local/bin/meclaw-acp" "$@"
