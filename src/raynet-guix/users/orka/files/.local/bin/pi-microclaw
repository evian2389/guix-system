#!/usr/bin/env python3
"""Pi terminal frontend for MicroClaw. One temporary loopback bridge per PC."""
import argparse
from collections import OrderedDict
from contextlib import closing
from datetime import datetime, timezone
import hashlib
import hmac
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
import os
from pathlib import Path
import re
import secrets
import select
import shlex
import shutil
import signal
import socket
import sqlite3
import subprocess
import tempfile
import threading
import time

PORT = 10962
PROVIDER = {'api':'openai-completions','baseUrl':f'http://127.0.0.1:{PORT}/v1',
            'apiKey':'MICROCLAW_PI_TOKEN','authHeader':True,
            'models':[{'id':'microclaw','name':'MicroClaw backend','reasoning':False,
                       'input':['text'],'contextWindow':65536,'maxTokens':4096}],
            'compat':{'supportsStore':False,'supportsDeveloperRole':False,'supportsReasoningEffort':False}}

def install_observer(source, home):
    config=json.loads(source.read_text())
    data=Path(config['data_dir']).expanduser()
    root=data.parent if data.name=='runtime' else data
    metadata={'name':'pi-microclaw-progress','description':'Observe Pi tool progress; never authorize tools',
              'events':['BeforeLLMCall','BeforeToolCall','AfterToolCall'],
              'command':shlex.quote(str(home/'.local/bin/pi-microclaw'))+' observe',
              'timeout_ms':1500,'priority':200,'enabled':True}
    atomic(root/'hooks/pi-microclaw-progress/HOOK.md','---\n'+json.dumps(metadata)+'\n---\n')

def observe(payload, path):
    """Observational hook: discard prompts, arguments, results and credentials."""
    name=payload.get('tool_name','tool')
    name=name if isinstance(name,str) and re.fullmatch(r'[a-zA-Z0-9_.:-]{1,80}',name) else 'tool'
    event=payload.get('event')
    if event=='BeforeToolCall': item={'event':'tool_start','tool':name}
    elif event=='AfterToolCall':
        result=payload.get('result',{})
        item={'event':'tool_result','tool':name,'is_error':bool(result.get('is_error')),
              'approval_required':result.get('error_type')=='approval_required'}
    elif event=='BeforeLLMCall': item={'event':'thinking'}
    else: return {'action':'allow'}
    if path is not None:
        fd=os.open(path,os.O_WRONLY|os.O_APPEND|os.O_CREAT|os.O_NOFOLLOW,0o600)
        try:
            if os.fstat(fd).st_size<2*1024*1024:
                os.write(fd,(json.dumps(item)+'\n').encode())
        finally: os.close(fd)
    return {'action':'allow'}

def pending_approval(data, chat_id):
    """Read the engine's pending marker without consuming or granting it."""
    if not isinstance(chat_id,int): return None
    data=Path(data)
    database=(data if data.name=='runtime' else data/'runtime')/'microclaw.db'
    try:
        with closing(sqlite3.connect(database.resolve().as_uri()+'?mode=ro',uri=True,timeout=1)) as db:
            row=db.execute('SELECT value FROM db_meta WHERE key=?',('pending_approval_tool:'+str(chat_id),)).fetchone()
        if not row: return None
        tool,stamp=row[0].split('\n',1)
        elapsed=(datetime.now(timezone.utc)-datetime.fromisoformat(stamp.replace('Z','+00:00'))).total_seconds()
        if 0<=elapsed<3600: return tool
    except (sqlite3.Error,OSError,ValueError,TypeError): pass
    return None

def atomic(path, text):
    path.parent.mkdir(parents=True,exist_ok=True,mode=0o700)
    fd,name=tempfile.mkstemp(dir=path.parent)
    try:
        with os.fdopen(fd,'w') as f: f.write(text)
        os.replace(name,path)
    finally:
        if os.path.exists(name): os.unlink(name)

def setup(path,provider=None,provider_name='microclaw-local'):
    provider=PROVIDER if provider is None else provider
    config=json.loads(path.read_text()) if path.exists() else {}
    providers=config.setdefault('providers',{})
    if provider_name in providers and providers[provider_name] != provider:
        raise ValueError('Existing '+provider_name+' provider differs; refusing to overwrite')
    providers[provider_name]=provider
    atomic(path,json.dumps(config,indent=2)+'\n')

def setup_profile(home,backend='microclaw',provider=None):
    profile=home/('.local/state/pi-'+backend+'/agent')
    setup(profile/'models.json',provider,backend+'-local')
    settings=profile/'settings.json'
    if not settings.exists():
        atomic(settings,json.dumps({'default_provider':backend+'-local','default_model':backend}))
    integration=home/'.pi/agent/extensions/herdr-agent-state.ts'
    target=profile/'extensions/herdr-agent-state.ts'
    if integration.exists() and not os.path.lexists(target):
        target.parent.mkdir(parents=True,exist_ok=True)
        target.symlink_to(integration)
    return profile

def extract_prompt(body,model='microclaw'):
    if not isinstance(body,dict) or body.get('model')!=model:
        raise ValueError('Use model '+model)
    if body.get('tools'):
        raise ValueError('Pi tools must be disabled; launch with pi-'+model)
    messages=body.get('messages')
    if not isinstance(messages,list) or not messages or not isinstance(messages[-1],dict) or messages[-1].get('role')!='user':
        raise ValueError('Expected a final user message')
    content=messages[-1].get('content')
    if isinstance(content,list):
        if any(not isinstance(p,dict) or p.get('type')!='text' or not isinstance(p.get('text'),str) for p in content):
            raise ValueError('This prototype supports text only')
        content='\n'.join(p['text'] for p in content)
    if not isinstance(content,str) or not content.strip() or len(content)>100000:
        raise ValueError('Expected nonempty text <=100000 characters')
    return content

def project_config(source, workspace, project):
    config=json.loads(source.read_text())
    workspace.mkdir(parents=True,exist_ok=True)
    hooks=config.get('channels',{}).get('hooks',{'enabled':True})
    if hooks.get('enabled',True) is False:
        raise ValueError('Pi progress requires MicroClaw hooks; hooks are disabled in gateway.json')
    # The native headless channel omits the web/work high-risk chat gate.
    # Use its native command-content approval gate for every nonempty bash
    # command when confirmation is enabled. This adds no control-chat grants
    # and keeps the engine responsible for pending markers and human replies.
    if config.get('high_risk_tool_user_confirmation_required',True):
        patterns=config.setdefault('bash_dangerous_patterns',[])
        if '(?s).+' not in patterns: patterns.append('(?s).+')
    config.update(working_dir=str(project.resolve()),working_dir_isolation='direct',
                  channels={'web':{'enabled':True},'hooks':hooks})
    # Credentials remain in this private temporary config; never print or commit it.
    path=workspace/'config.json'
    atomic(path,json.dumps(config))
    return path

def stop(process):
    if process.poll() is None:
        os.killpg(process.pid,signal.SIGTERM)
        try: process.wait(timeout=3)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid,signal.SIGKILL)
            process.wait()

def invoke(argv,cancel,timeout,events=None,emit=None,data=None,input_text=None,parse_result=None,label='MicroClaw'):
    emit=emit or (lambda event: None)
    reader=open(events) if events is not None else None
    def progress():
        if reader is None: return
        while True:
            position=reader.tell()
            line=reader.readline()
            if not line.endswith('\n'):
                reader.seek(position);break
            try: emit(json.loads(line))
            except json.JSONDecodeError: continue
    with tempfile.TemporaryFile() as output, tempfile.TemporaryFile() as error, tempfile.TemporaryFile() as incoming:
        if input_text is not None: incoming.write(input_text.encode());incoming.seek(0)
        process=subprocess.Popen(argv,stdout=output,stderr=error,stdin=incoming if input_text is not None else subprocess.DEVNULL,start_new_session=True)
        try:
            deadline=time.monotonic()+timeout
            while process.poll() is None:
                progress()
                if cancel(): raise InterruptedError('Frontend disconnected; '+label+' client stopped')
                if time.monotonic()>deadline: raise TimeoutError(label+' request timed out')
                if os.fstat(output.fileno()).st_size>8*1024*1024:
                    raise ValueError(label+' output exceeded 8 MiB')
                time.sleep(0.1)
            progress()
            if process.returncode:
                raise ValueError(label+' client failed; inspect its service and authentication')
            output.seek(0)
            text=output.read(8*1024*1024).decode('utf-8',errors='replace')
            text=re.sub(r'\x1b\[[0-?]*[ -/]*[@-~]','',text)
            if parse_result is not None: return parse_result(text)
            envelopes=[line for line in text.splitlines() if line.startswith('{')]
            result=json.loads(envelopes[-1]) if envelopes else {}
            if not result.get('ok') or not isinstance(result.get('response'),str):
                raise ValueError('MicroClaw returned no successful response')
            counts=[match for line in text.splitlines() if 'Agent iteration completed' in line
                    for match in re.findall(r'input_tokens=(\d+) output_tokens=(\d+)',line)]
            usage={'prompt_tokens':sum(int(a) for a,_ in counts),'completion_tokens':sum(int(b) for _,b in counts)}
            usage['total_tokens']=sum(usage.values())
            approval=pending_approval(data,result.get('chat_id')) if data is not None else None
            return {'text':result['response'],'usage':usage,'approval':approval}
        finally:
            stop(process)
            if reader is not None: reader.close()

class App:
    def __init__(self,token,run,report=None,model='microclaw',label='MicroClaw'):
        self.token=token
        self.run=run
        self.lock=threading.Lock()
        self.cache=OrderedDict()
        self.stopping=threading.Event()
        self.report=report or (lambda state: None)
        self.approval=None
        self.model=model
        self.label=label

def progress_text(event,label='MicroClaw'):
    prefix='['+label+'] '
    if event.get('event')=='tool_start': return prefix+'시작: '+event['tool']+'\n'
    if event.get('event')=='tool_result':
        status='승인 필요' if event.get('approval_required') else ('오류' if event.get('is_error') else '완료')
        return prefix+status+': '+event['tool']+'\n'
    if event.get('event')=='thinking': return prefix+'응답 준비 중…\n'
    return ''

class Server(ThreadingHTTPServer):
    daemon_threads=False
    def __init__(self,address,app):
        self.app=app
        super().__init__(address,Handler)

class Handler(BaseHTTPRequestHandler):
    def log_message(self,*args): pass
    def send_json(self,status,value):
        content=json.dumps(value).encode()
        self.send_response(status)
        self.send_header('Content-Type','application/json')
        self.send_header('Content-Length',str(len(content)))
        self.end_headers()
        self.wfile.write(content)
    def authorized(self):
        return hmac.compare_digest(self.headers.get('Authorization','').encode(),('Bearer '+self.server.app.token).encode())
    def do_GET(self):
        if self.path=='/health': self.send_json(200,{'ok':True});return
        if not self.authorized(): self.send_json(401,{'error':{'message':'Unauthorized'}});return
        if self.path=='/v1/models': self.send_json(200,{'object':'list','data':[{'id':self.server.app.model,'object':'model','owned_by':'local'}]});return
        self.send_json(404,{'error':{'message':'Not found'}})
    def disconnected(self):
        if self.server.app.stopping.is_set(): return True
        ready,_,_=select.select([self.connection],[],[],0)
        return bool(ready and self.connection.recv(1,socket.MSG_PEEK)==b'')
    def do_POST(self):
        app=self.server.app
        acquired=False
        streaming=False
        try:
            if not self.authorized(): self.send_json(401,{'error':{'message':'Unauthorized'}});return
            if self.path!='/v1/chat/completions': self.send_json(404,{'error':{'message':'Not found'}});return
            length=int(self.headers.get('Content-Length','0'))
            if not 0<length<=1024*1024: raise ValueError('Request must be <=1 MiB')
            self.connection.settimeout(15)
            body=json.loads(self.rfile.read(length))
            prompt=extract_prompt(body,app.model)
            acquired=app.lock.acquire(blocking=False)
            if not acquired: self.send_json(409,{'error':{'message':app.label+' bridge is busy'}});return
            app.report('working')
            # Retries of the same frontend turn reuse a successful result.
            key=hashlib.sha256(json.dumps(body['messages'],sort_keys=True).encode()).hexdigest()
            response_id='chatcmpl-'+key[:20]
            def chunk(content='',finish=None,usage=None):
                value={'id':response_id,'object':'chat.completion.chunk','created':int(time.time()),'model':app.model,
                       'choices':[{'index':0,'delta':{'content':content} if finish is None else {},'finish_reason':finish}]}
                if usage is not None: value['usage']=usage
                self.wfile.write(('data: '+json.dumps(value)+'\n\n').encode());self.wfile.flush()
            def emit(event):
                text=progress_text(event,app.label)
                if streaming and text: chunk(text)
            if body.get('stream'):
                self.send_response(200)
                self.send_header('Content-Type','text/event-stream')
                self.send_header('Cache-Control','no-cache')
                self.end_headers()
                streaming=True
            if key not in app.cache:
                app.cache[key]=app.run(prompt,self.disconnected,emit)
                if len(app.cache)>32: app.cache.popitem(last=False)
            result=app.cache[key]
            app.approval=result.get('approval')
            text=result['text']
            if app.approval:
                text+='\n\n[MicroClaw 승인 대기] Pi 입력창에 1(이번만 승인), 2(이 대화에서 항상 허용), 3(거절)을 직접 입력하세요. 자동 응답하지 않습니다.'
            if streaming:
                chunk(text)
                chunk(finish='stop',usage=result['usage'])
                self.wfile.write(b'data: [DONE]\n\n');self.wfile.flush()
            else:
                self.send_json(200,{'id':response_id,'object':'chat.completion','created':int(time.time()),'model':app.model,
                    'choices':[{'index':0,'message':{'role':'assistant','content':text},'finish_reason':'stop'}],'usage':result['usage']})
        except (BrokenPipeError,ConnectionResetError,InterruptedError): pass
        except (TimeoutError,ValueError,KeyError,TypeError,OSError) as exc:
            message=app.label+' timed out' if isinstance(exc,TimeoutError) else str(exc)
            if streaming:
                try:
                    self.wfile.write(('data: '+json.dumps({'error':{'message':message}})+'\n\n').encode())
                    self.wfile.write(b'data: [DONE]\n\n');self.wfile.flush()
                except OSError: pass
            else: self.send_json(504 if isinstance(exc,TimeoutError) else 400,{'error':{'message':message}})
        finally:
            if acquired:
                try: app.report('blocked' if app.approval else 'idle')
                finally: app.lock.release()

def report_herdr(state,source='custom:pi-microclaw'):
    pane=os.environ.get('HERDR_PANE_ID')
    if os.environ.get('HERDR_ENV')!='1' or not pane or not shutil.which('herdr'): return
    if state=='release':
        command=['herdr','pane','release-agent',pane,'--source',source,'--agent','pi']
    else:
        command=['herdr','pane','report-agent',pane,'--source',source,'--agent','pi',
                 '--state',state,'--seq',str(time.time_ns()//1000)]
    try: subprocess.run(command,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=3)
    except (OSError,subprocess.TimeoutExpired): pass

def pi_command():
    binary=Path.home()/'.local/bin/pi'
    if not binary.is_file(): raise ValueError('Install Pi first: '+str(binary))
    # The existing release binary targets /lib64. Keep it intact and use Guix's loader.
    if Path('/lib64/ld-linux-x86-64.so.2').exists(): return [str(binary)]
    paths=subprocess.check_output(['guix','build','glibc'],text=True).splitlines()
    loader=next((Path(p)/'lib/ld-linux-x86-64.so.2' for p in paths if (Path(p)/'lib/ld-linux-x86-64.so.2').exists()),None)
    if loader is None: raise ValueError('Guix glibc loader not found')
    gcc_lib=Path(subprocess.check_output(['gcc','-print-file-name=libgcc_s.so.1'],text=True).strip()).resolve().parent
    # Herdr validates the foreground executable; a direct ld-linux invocation is
    # not a Pi executable. Patch a private copy, preserving the installed binary.
    directory=Path.home()/'.local/libexec/pi-microclaw'
    target=directory/'pi'
    signature=hashlib.sha256(binary.read_bytes()+str(loader).encode()+str(gcc_lib).encode()).hexdigest()
    stamp=directory/'source.sha256'
    if not target.exists() or not stamp.exists() or stamp.read_text()!=signature:
        paths=subprocess.check_output(['guix','build','patchelf'],text=True).splitlines()
        patcher=next((Path(p)/'bin/patchelf' for p in paths if (Path(p)/'bin/patchelf').exists()),None)
        if patcher is None: raise ValueError('Guix patchelf not found')
        directory.mkdir(parents=True,exist_ok=True,mode=0o700)
        fd,name=tempfile.mkstemp(prefix='pi-',dir=directory);os.close(fd)
        try:
            shutil.copy2(binary,name)
            subprocess.run([str(patcher),'--set-interpreter',str(loader),'--set-rpath',
                            str(gcc_lib)+':'+str(loader.parent),name],check=True)
            os.chmod(name,0o755)
            os.replace(name,target)
            atomic(stamp,signature)
        finally:
            if os.path.exists(name): os.unlink(name)
    return [str(target)]

def main():
    os.umask(0o077)
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command',nargs='?',choices=['setup','run','observe'],default='run')
    parser.add_argument('--session',default='default',help='MicroClaw conversation label within this project')
    parser.add_argument('--timeout',type=int,default=600)
    parser.add_argument('--prompt',help='Single noninteractive smoke request through Pi')
    args=parser.parse_args()
    if args.command=='observe':
        path=os.environ.get('PI_MICROCLAW_EVENTS')
        if not path: print('{"action":"allow"}');return
        payload=json.load(__import__('sys').stdin)
        print(json.dumps(observe(payload,Path(path))))
        return
    profile=setup_profile(Path.home())
    source=Path.home()/'.local/share/microclaw-workflow/gateway.json'
    if source.exists(): install_observer(source,Path.home())
    if args.command=='setup': print('Registered microclaw-local Pi provider');return
    def terminate(signum,frame): raise KeyboardInterrupt
    signal.signal(signal.SIGTERM,terminate)
    project=Path.cwd().resolve()
    if not re.fullmatch(r'[a-zA-Z0-9_.-]{1,80}',args.session) or not 1<=args.timeout<=3600:
        parser.error('Session must be 1..80 letters/digits/._-; timeout must be 1..3600')
    label='pi-'+hashlib.sha256(str(project).encode()).hexdigest()[:12]+'-'+args.session
    token=secrets.token_urlsafe(32)
    with tempfile.TemporaryDirectory(prefix='pi-microclaw-') as temp:
        config=project_config(source,Path(temp)/'workspace',project)
        # This installed Pi release treats custom-provider env key names literally.
        # Supply the one-launch bridge key in a private temporary profile, never argv.
        runtime_profile=Path(temp)/'agent'
        runtime_provider=json.loads(json.dumps(PROVIDER));runtime_provider['apiKey']=token
        atomic(runtime_profile/'models.json',json.dumps({'providers':{'microclaw-local':runtime_provider}}))
        atomic(runtime_profile/'settings.json',(profile/'settings.json').read_text())
        if (profile/'extensions').exists():
            (runtime_profile/'extensions').symlink_to(profile/'extensions',target_is_directory=True)
        events=Path(temp)/'events.jsonl'
        atomic(events,'')
        data=json.loads(config.read_text())['data_dir']
        def run(prompt,cancel,emit):
            atomic(events,'')
            return invoke([str(Path.home()/'.local/bin/microclaw'),'--config',str(config),'run',
                           '--json','--session',label,'--prompt',prompt],cancel,args.timeout,events,emit,data)
        reporter=report_herdr if args.prompt is None else (lambda state: None)
        try: server=Server(('127.0.0.1',PORT),App(token,run,reporter))
        except OSError as exc: raise ValueError('Bridge port 10962 unavailable; only one pi-microclaw may run per PC') from exc
        thread=threading.Thread(target=server.serve_forever,daemon=True);thread.start()
        env=os.environ.copy()
        env['PI_CODING_AGENT_DIR']=str(runtime_profile)
        env['PI_CONFIG_PATH']=str(runtime_profile/'settings.json')
        env['PI_SESSIONS_DIR']=str(profile/'sessions')
        # Only this launcher and its owned backend inherit the observational path.
        # The gateway sees no event path and the hook becomes a no-op there.
        os.environ['PI_MICROCLAW_EVENTS']=str(events)
        command=pi_command()+['--provider','microclaw-local','--model','microclaw','--no-tools','--no-skills','--no-prompt-templates']
        if args.prompt is not None: command+=['--print',args.prompt]
        print('MicroClaw session: '+label+' | workspace: '+str(project),flush=True)
        try:
            child=subprocess.Popen(command,env=env)
            reporter('idle')
            try: code=child.wait()
            except KeyboardInterrupt:
                child.terminate()
                try: child.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    child.kill();child.wait()
                code=130
        finally:
            server.app.stopping.set()
            server.shutdown();server.server_close()
            reporter('release')
        raise SystemExit(code)

if __name__=='__main__':
    try: main()
    except (ValueError,OSError,subprocess.SubprocessError) as exc:
        print(str(exc),file=__import__('sys').stderr)
        raise SystemExit(1)
